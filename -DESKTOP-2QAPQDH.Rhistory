hist(dt_clean$edad)
# new age groups adults 16-18
dt_clean <- dt_clean %>%
mutate(edad_cat3 = case_when(
edad >= 0 & edad <= 2 ~ "0-2",           # Exclude from sedentarism analysis
edad >= 3 & edad <= 5 ~ "3-5 (Infantil)",  # Educación Infantil (last cycle)
edad >= 6 & edad <= 11 ~ "6-11 (Primaria)", # Educación Primaria
edad >= 12 & edad <= 15 ~ "12-15 (ESO)",    # Educación Secundaria Obligatoria
edad >= 16 & edad <= 18 ~ "16-18 (Bachillerato)" # Bachillerato or Formación Profesional
))
# new age groups adults 16-18
dt_clean <- dt_clean %>%
mutate(edad_cat3 = case_when(
edad >= 0 & edad <= 2 ~ "0-2",           # Exclude from sedentarism analysis
edad >= 3 & edad <= 5 ~ "3-5 (Infantil)",  # Educación Infantil (last cycle)
edad >= 6 & edad <= 11 ~ "6-11 (Primaria)", # Educación Primaria
edad >= 12 & edad <= 15 ~ "12-15 (ESO)",    # Educación Secundaria Obligatoria
edad >= 16 & edad <= 18 ~ "16-18 (Bachillerato)" # Bachillerato or Formación Profesional
))
# function for each age group
get_prevalence <- function(data, age_group) {
data %>%
filter(edad_cat3 == age_group) %>%
as_survey_design(weights = factor2) %>%
group_by(survey) %>%
summarize(sedentarismo = survey_mean(sedentarismo, vartype = "ci")) %>%
mutate(edad_cat2 = age_group)
}
# apply function to each group and bind results
combined_prevalence <- bind_rows(
get_prevalence(dt_clean, "3-5 (Infantil)"),
get_prevalence(dt_clean, "6-11 (Primaria)"),
get_prevalence(dt_clean, "12-15 (ESO)"),
get_prevalence(dt_clean, "16-18 (Bachillerato)")
)
# years as columns
combined_wide <- combined_prevalence %>%
mutate(age_str = case_when(
edad_cat3 == "3-5 (Infantil)" ~ "3-5 years",
edad_cat3 == "6-11 (Primaria)" ~ "6–11 years",
edad_cat3 == "12-15 (ESO)" ~ "12–15 years",
edad_cat3 == "16-18 (Bachillerato)" ~ "16–18 years"
)) %>%
mutate(
prevalence_str = paste0(
round(sedentarismo * 100, 1), "% (",
round(sedentarismo_low * 100, 1), "–",
round(sedentarismo_upp * 100, 1), "%)"
)
) %>%
select(survey, age_str, prevalence_str) %>%
pivot_wider(
names_from = age_str,
values_from = prevalence_str
)
